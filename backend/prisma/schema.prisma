generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  PATIENT
  DOCTOR
  ADMIN
}
enum AppointmentStatus {
  HELD
  CONFIRMED
  CANCELLED
  COMPLETED
}
enum LlmStatus {
  PENDING
  SUCCESS
  FAILED
}
enum NotificationType {
  BOOKING_CONFIRMATION
  CANCELLATION
  RESCHEDULE
  REMINDER
  LEAVE_CANCELLATION
  MEDICATION_REMINDER
}
enum NotificationChannel {
  EMAIL
  IN_APP
}
enum NotificationStatus {
  PENDING
  SENT
  FAILED
}
enum CalendarSyncStatus {
  PENDING
  SYNCED
  FAILED
}
enum ReminderStatus {
  PENDING
  SENT
  CANCELLED
}
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role
  createdAt DateTime @default(now())
  patientAppointments Appointment[] @relation("PatientAppointments")
  doctorProfile       DoctorProfile?
  auditLogs           AuditLog[]
  @@map("users")
}
model DoctorProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialisation      String
  workingHours        Json
  slotDurationMinutes Int      @default(30)
  consultationFee     Float?
  bio                 String?  @db.Text
  createdAt           DateTime @default(now())
  appointments Appointment[]
  leaves       DoctorLeave[]
  @@map("doctor_profiles")
}
model DoctorLeave {
  id        String   @id @default(cuid())
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String?
  createdBy String?
  createdAt DateTime @default(now())
  @@index([doctorId])
  @@map("doctor_leaves")
}
model Appointment {
  id             String            @id @default(cuid())
  patientId      String
  patient        User              @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String
  doctor         DoctorProfile     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  slotStart      DateTime
  slotEnd        DateTime
  status         AppointmentStatus @default(HELD)
  holdExpiresAt  DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  symptomForm    SymptomForm?
  visitNote      VisitNote?
  calendarEvents CalendarEvent[]
  @@unique([doctorId, slotStart])
  @@index([doctorId, slotStart])
  @@index([patientId])
  @@index([status])
  @@map("appointments")
}
model SymptomForm {
  id                 String    @id @default(cuid())
  appointmentId      String    @unique
  appointment        Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  rawSymptoms        String    @db.Text
  duration           String?
  severity           String?
  existingConditions String?   @db.Text
  structured         Json?
  urgencyLevel       String?
  llmStatus          LlmStatus @default(PENDING)
  llmRaw             String?   @db.Text
  createdAt          DateTime  @default(now())
  @@map("symptom_forms")
}
model VisitNote {
  id                 String    @id @default(cuid())
  appointmentId      String    @unique
  appointment        Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  clinicalNotes      String    @db.Text
  prescription       Json?
  patientSummary     String?   @db.Text
  patientSummaryJson Json?
  llmStatus          LlmStatus @default(PENDING)
  createdAt          DateTime  @default(now())
  reminders MedicationReminder[]
  @@map("visit_notes")
}
model MedicationReminder {
  id          String         @id @default(cuid())
  visitNoteId String
  visitNote   VisitNote      @relation(fields: [visitNoteId], references: [id], onDelete: Cascade)
  drug        String
  dosage      String
  frequency   String
  duration    String
  nextSendAt  DateTime
  status      ReminderStatus @default(PENDING)
  lastSentAt  DateTime?
  createdAt   DateTime       @default(now())
  @@index([nextSendAt])
  @@map("medication_reminders")
}
model NotificationLog {
  id            String             @id @default(cuid())
  type          NotificationType
  recipient     String
  channel       NotificationChannel @default(EMAIL)
  status        NotificationStatus @default(PENDING)
  retryCount    Int                @default(0)
  error         String?            @db.Text
  relatedEntity String?
  relatedId     String?
  payload       Json?
  createdAt     DateTime           @default(now())
  @@index([status])
  @@map("notification_logs")
}
model CalendarEvent {
  id            String             @id @default(cuid())
  appointmentId String
  appointment   Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  googleEventId String?
  ownerEmail    String
  syncStatus    CalendarSyncStatus @default(PENDING)
  createdAt     DateTime           @default(now())
  @@map("calendar_events")
}
model AuditLog {
  id         String   @id @default(cuid())
  action     String
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  targetType String?
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())
  @@map("audit_logs")
}
